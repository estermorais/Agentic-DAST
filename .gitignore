# Dependências Node.js
node_modules/

# Variáveis de ambiente (segredos)
.env
.env.local
.env.*.local

# Build TypeScript — a pasta dist/ é versionada (contém os .js compilados),
# mas os arquivos auxiliares (.js.map e .d.ts) são ignorados para manter o
# diff limpo e o repositório legível.
*.js.map
*.d.ts
*.d.ts.map

# Relatórios gerados pelo agente (JSONs individuais, transcripts, backups)
agentic-dast/reports/*
# Exceções: artefatos consolidados e log oficial da rodada n=30 SÃO versionados
!agentic-dast/reports/tcc-artifacts/
!agentic-dast/reports/_run-log.csv
!agentic-dast/reports/_evaluation-summary.json

# Logs
*.log
npm-debug.log*

# Sistema operacional
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# LaTeX auxiliares (gerados na compilação)
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls
*.nav
*.snm
*.vrb
*.pdf
# Excecoes: PDFs vetoriais gerados como artefatos do TCC 2 SAO versionados
!agentic-dast/reports/tcc-artifacts/*.pdf

# Claude Code
.claude/

# Documentação de TCC / artigo / metodologia — específica das atividades
# acadêmicas, não faz parte do agente público.
docs/
