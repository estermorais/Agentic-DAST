# Dependências Node.js
node_modules/

# Variáveis de ambiente (segredos)
.env
.env.local
.env.*.local

# Cache de sessão do modo produção (material de autenticação cifrado —
# NUNCA versionar, mesmo cifrado)
.session-cache/
agentic-dast/.session-cache/

# Build TypeScript — a pasta dist/ é gerada por 'npm run build' e NÃO é
# versionada (artefato de build; regenere localmente após clonar).
agentic-dast/dist/
*.js.map
*.d.ts
*.d.ts.map

# Relatórios gerados pelo agente (JSONs individuais, transcripts, backups)
agentic-dast/reports/*
# Exceções: artefatos consolidados e log oficial da rodada n=30 SÃO versionados
!agentic-dast/reports/tcc-artifacts/
!agentic-dast/reports/_run-log.csv
!agentic-dast/reports/_evaluation-summary.json

# Logs
*.log
npm-debug.log*

# Sistema operacional
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# LaTeX auxiliares (gerados na compilação)
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls
*.nav
*.snm
*.vrb
*.pdf
# Excecoes: PDFs vetoriais gerados como artefatos do TCC 2 SAO versionados
!agentic-dast/reports/tcc-artifacts/*.pdf

# Claude Code
.claude/

# Documentação de TCC / artigo / metodologia — específica das atividades
# acadêmicas, não faz parte do agente público. Ancorado na raiz (barra
# inicial) para NÃO afetar agentic-dast/docs/ (documentação técnica).
/docs/
