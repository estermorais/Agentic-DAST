  },
  "entries": [
    {
      "id": "GT-BLV-01",
      "category": "BUSINESS_LOGIC",
      "challengeName": "Negative Order",
      "description": "É possível adicionar quantidade negativa ao carrinho via PUT /api/BasketItems/:id, resultando em desconto indevido no pedido.",
      "endpoint": "PUT /api/BasketItems/:id",
      "detectionKeywords": ["negative", "negativa", "quantidade", "quantity", "negative order"],
      "expectedSeverity": "HIGH"
    },
    {
      "id": "GT-BLV-02",
      "category": "BUSINESS_LOGIC",
      "challengeName": "Zero Stars",
      "description": "É possível enviar review com rating zero (fora do intervalo válido 1-5) via POST /api/Feedbacks.",
      "endpoint": "POST /api/Feedbacks",
      "detectionKeywords": ["zero star", "zero estrela", "rating zero", "input validation", "feedback rating"],
      "expectedSeverity": "MEDIUM"
    },
    {
      "id": "GT-BLV-03",
      "category": "BUSINESS_LOGIC",
      "challengeName": "Forged Coupon",
      "description": "Cupom de desconto pode ser falsificado por engenharia reversa do algoritmo de geração no frontend.",
      "endpoint": "PUT /rest/basket/:id/coupon",
      "detectionKeywords": ["coupon", "cupom", "forged coupon", "discount"],
      "expectedSeverity": "MEDIUM"
    },
    {
