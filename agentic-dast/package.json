{
  "name": "agentic-dast",
  "version": "1.0.0",
  "description": "Framework agentico para deteccao de vulnerabilidades de logica de negocio em SPAs",
  "main": "dist/index.js",
  "scripts": {
    "start": "ts-node src/index.ts",
    "scenario:a": "ts-node src/scenarios/scenario-a.ts",
    "scenario:b": "ts-node src/scenarios/scenario-b.ts",
    "scenario:c": "ts-node src/index.ts",
    "evaluate": "ts-node src/evaluation/evaluate.ts",
    "build": "tsc && node -e \"require('fs').copyFileSync('src/evaluation/ground-truth.json', 'dist/evaluation/ground-truth.json')\"",
    "dev": "ts-node --watch src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "puppeteer": "^22.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
