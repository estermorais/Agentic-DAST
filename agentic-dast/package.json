{
  "name": "agentic-dast",
  "version": "1.0.0",
  "description": "Framework agentico para deteccao de vulnerabilidades de logica de negocio em SPAs",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "test:llm": "node dist/scripts/test-llm.js",
    "scenario:a": "node dist/scenarios/scenario-a.js",
    "scenario:b": "node dist/scenarios/scenario-b.js",
    "scenario:c": "node dist/index.js",
    "scenario:d": "node dist/scenarios/scenario-d.js",
    "evaluate": "node dist/evaluation/evaluate.js",
    "build": "tsc && node -e \"require('fs').copyFileSync('src/evaluation/ground-truth.json', 'dist/evaluation/ground-truth.json'); require('fs').mkdirSync('dist/scenarios/pentestgpt', { recursive: true }); require('fs').copyFileSync('src/scenarios/pentestgpt/run_pentestgpt.py', 'dist/scenarios/pentestgpt/run_pentestgpt.py')\"",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "puppeteer": "^22.15.0"
  },
  "overrides": {
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
