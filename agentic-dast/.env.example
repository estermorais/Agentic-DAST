# =============================================================
# Copie este arquivo para .env e preencha os valores
# NUNCA faça commit do arquivo .env com chaves reais
# =============================================================

# Chave da API Anthropic (obtenha em https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# URL do alvo (Juice Shop rodando via Docker)
TARGET_URL=http://localhost:3000

# Configurações do OWASP ZAP
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=zapkey123
ZAP_PROXY_HOST=localhost
ZAP_PROXY_PORT=8888

# Modelo da Claude a usar (haiku = mais rápido/barato, sonnet = mais capaz)
# claude-haiku-4-5-20251001 ou claude-sonnet-4-6
LLM_MODEL=claude-haiku-4-5-20251001

# Número máximo de iterações do loop ReAct (evita loops infinitos)
MAX_REACT_ITERATIONS=25

# Habilitar proxy ZAP no Puppeteer? (true/false)
USE_ZAP_PROXY=true
