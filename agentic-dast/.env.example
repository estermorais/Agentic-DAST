# =============================================================
# Copie este arquivo para .env e preencha os valores
# NUNCA faça commit do arquivo .env com chaves reais
# =============================================================

# ── Provedor de LLM ─────────────────────────────────────────
# Aceita: 'anthropic' (padrão, experimentos finais)
#         'ollama'    (LLM local, smoke tests sem custo)
LLM_PROVIDER=anthropic

# ── Anthropic (usado quando LLM_PROVIDER=anthropic) ─────────
# Chave da API obtida em https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modelo do Claude (haiku = mais rápido/barato, sonnet = mais capaz)
# Opções: claude-haiku-4-5-20251001 | claude-sonnet-4-6
LLM_MODEL=claude-haiku-4-5-20251001

# ── Ollama (usado quando LLM_PROVIDER=ollama) ───────────────
# Pré-requisito: Ollama instalado e rodando localmente
#   Instalação:  https://ollama.com/download
#   Após instalar, baixe um modelo:
#     ollama pull qwen2.5:7b      (recomendado, ~4.5 GB)
#     ollama pull llama3.1:8b     (alternativa, ~5 GB)
#     ollama pull llama3.2:3b     (mais leve, ~2 GB)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Alvo do experimento ─────────────────────────────────────
TARGET_URL=http://localhost:3000

# ── OWASP ZAP ───────────────────────────────────────────────
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=zapkey123
ZAP_PROXY_HOST=localhost
ZAP_PROXY_PORT=8888

# ── Comportamento do agente ─────────────────────────────────
# Número máximo de iterações do loop ReAct (evita loops infinitos)
MAX_REACT_ITERATIONS=25

# Habilitar proxy ZAP no Puppeteer? (true/false)
USE_ZAP_PROXY=true
