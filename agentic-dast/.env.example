# =============================================================
# Copie este arquivo para .env e preencha os valores
# NUNCA faça commit do arquivo .env com chaves reais
# =============================================================

# ── Provedor de LLM ─────────────────────────────────────────
# Aceita:
#   'openrouter' (padrão, proxy que dá acesso a Claude, GPT-4, etc.
#                 com uma única chave — usado nos experimentos finais)
#   'anthropic'  (chamada direta à API da Anthropic, requer conta paga
#                 lá — alternativa se preferir não passar por proxy)
#   'ollama'     (LLM local, smoke tests sem custo)
LLM_PROVIDER=openrouter

# ── OpenRouter (usado quando LLM_PROVIDER=openrouter) ───────
# Chave obtida em https://openrouter.ai/keys
# Uma única chave dá acesso a Claude, GPT-4, Gemini, Llama e outros.
OPENROUTER_API_KEY=sk-or-v1-...

# Modelo a usar (formato 'provedor/modelo').
# Para o Cenário C do experimento, usamos Claude Haiku 4.5:
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Alternativas:
#   anthropic/claude-sonnet-4.6   (mais capaz, ~3x mais caro)
#   openai/gpt-4-turbo            (para o Cenário D, PentestGPT)
#   openai/gpt-4o                 (GPT-4o, mais barato que Turbo)

# URL base da API do OpenRouter (raramente muda)
OPENROUTER_URL=https://openrouter.ai/api/v1

# Temperatura dos provedores hospedados (OpenRouter/Anthropic).
# Se comentada/vazia, usa o default do provedor (1.0) — preserva o
# baseline do TCC byte-a-byte. Em PRODUÇÃO recomenda-se 0.2 (o loop
# ReAct exige JSON estrito e disciplina anti-alucinação, não criatividade).
# Também serve para um estudo A/B (1.0 vs 0.2) com a mesma ground truth.
# LLM_TEMPERATURE=0.2

# Exemplos few-shot no system prompt (só produção; default off). Quando
# 'true', anexa 2 exemplos ilustrativos (achado legítimo + sessão
# inconclusiva honesta) em domínio fictício, para reduzir alucinação.
# Não afeta o baseline do TCC (que roda sem exemplos).
# USE_FEWSHOT=true

# Achados passivos (headers/CSP/CORS/cookies/info-disclosure) reportáveis
# só com evidência de header. Ligado por padrão em produção e sempre em
# READ_ONLY. Desligue com REPORT_PASSIVE=false.
# REPORT_PASSIVE=true

# Ações page_fetch/execute_js: rodam fetch/JS DENTRO da página autenticada.
# Essencial para SPA/Auth0 com access token em memória (make_request sai
# anônimo). Opt-in.
# USE_PAGE_JS=true

# Caps de corpo nas Observations. Defaults = histórico (baseline intacto).
# Em app real, eleve para o recon ler bundles JS e HTML completo.
# HTTP_MAX_BODY_CHARS=200000
# READ_PAGE_MAX_CHARS=20000
# READ_PAGE_INCLUDE_SOURCE=true

# Tarifas USD/MTok da telemetria de custo. Default deriva do modelo (Kimi
# vs Haiku). Sobrescreva para outros modelos.
# LLM_PRICE_INPUT=0.71
# LLM_PRICE_OUTPUT=3.21
# LLM_PRICE_CACHE_READ=0.18

# ── Anthropic (chamada direta, alternativa ao OpenRouter) ───
# Só é necessário se LLM_PROVIDER=anthropic.
# Chave obtida em https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modelo do Claude na chamada direta (formato interno da Anthropic)
LLM_MODEL=claude-haiku-4-5-20251001

# ── Ollama (usado quando LLM_PROVIDER=ollama) ───────────────
# Pré-requisito: Ollama instalado e rodando localmente
#   Instalação:  https://ollama.com/download
#   Após instalar, baixe um modelo:
#     ollama pull qwen2.5:7b      (recomendado, ~4.5 GB)
#     ollama pull llama3.1:8b     (alternativa, ~5 GB)
#     ollama pull llama3.2:3b     (mais leve, ~2 GB)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Alvo do experimento ─────────────────────────────────────
TARGET_URL=http://localhost:3000

# ── OWASP ZAP ───────────────────────────────────────────────
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=zapkey123
ZAP_PROXY_HOST=localhost
ZAP_PROXY_PORT=8888

# ── Comportamento do agente ─────────────────────────────────
# Número máximo de iterações do loop ReAct (evita loops infinitos)
MAX_REACT_ITERATIONS=25
# Orçamento de gasto (USD) do loop ReAct. Quando > 0, o agente encerra
# assim que o custo acumulado das chamadas ao LLM passa desse valor —
# critério de parada por dinheiro, complementar ao número de iterações
# (o que vier primeiro). 0 = desativado. Só vale p/ providers que medem
# custo (OpenRouter, Anthropic); em Ollama/claude-cli é sempre 0.
MAX_COST_USD=0

# Habilitar proxy ZAP no Puppeteer? (true/false)
USE_ZAP_PROXY=true

# ── Autenticação / sessão (modo produção) ───────────────────
# Login manual assistido: abre o Chromium visível, você loga
# (senha + MFA + SSO) e ao ENTER a sessão é capturada.
INTERACTIVE_LOGIN=false

# Cache de sessão: salva a sessão capturada CIFRADA em .session-cache/
# e reaproveita nas próximas execuções — se ainda for válida — evitando
# refazer o login a cada teste. Só vale para o modo produção.
SESSION_CACHE=true
# Força reautenticação: ignora o cache e refaz o login manual,
# sobrescrevendo a sessão salva. Use ao trocar de usuário ou quando a
# sessão expirou sem a verificação pegar.
FORCE_REAUTH=false
# Senha para cifrar a sessão salva (AES-256-GCM). Vazia = chave derivada
# da máquina (protege contra leitura casual do disco, não contra atacante
# com acesso à mesma conta). Defina para endurecer.
SESSION_PASSPHRASE=
# Idade máxima (min) de uma sessão em cache antes de ser descartada sem
# testar. Default 720 (12h). 0 = sem limite (só a verificação decide).
SESSION_MAX_AGE_MIN=720

# Contexto da aplicação (opcional): caminho para um arquivo texto/Markdown
# que descreve a aplicação-alvo — papéis/permissões, o que é dado público
# por design, fluxos esperados etc. É anexado ao system prompt para ajudar
# o LLM a distinguir uma vulnerabilidade real de um caso de uso legítimo
# (reduz falso-positivo). Vazio = sem contexto extra. Exemplo em
# production-mode/app-context.example.md.
APP_CONTEXT_FILE=
# Limite de caracteres do contexto acima antes de truncar (protege a
# janela de contexto do LLM). Default 20000.
APP_CONTEXT_MAX_CHARS=20000
