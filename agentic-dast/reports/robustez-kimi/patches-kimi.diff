+ * e o proprio ZAP (HTTP 502). Reescreve a origem de loopback do alvo para
+ * config.browserBaseUrl (juice-shop:3000), como ja era feito para URLs
+ * relativas. Sem proxy, browserBaseUrl === targetUrl e nada muda.
+ */
+function rewriteLoopback(url: string): string {
+  try {
+    const u = new URL(url);
+    const target = new URL(config.targetUrl);
+    const base = new URL(config.browserBaseUrl);
+    const loopback = ['localhost', '127.0.0.1', target.hostname];
+    if (loopback.includes(u.hostname) && (u.port || '80') === (target.port || '80') && base.host !== u.host) {
+      u.protocol = base.protocol;
+      u.host = base.host;
+      return u.toString();
+    }
+  } catch { /* URL invalida: devolve como veio */ }
+  return url;
+}
